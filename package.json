{
  "name": "listeners-library",
  "version": "0.2.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "notices": "node scripts/build-notices.mjs",
    "build:windows": "node scripts/native-build.mjs build",
    "dev:desktop": "node scripts/native-build.mjs dev",
    "check:release": "node scripts/check-release.mjs",
    "test:native": "node scripts/native-build.mjs test",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shaka-player": "^5.2.13"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
